# Token for a NEW bot from @BotFather
TELEGRAM_BOT_TOKEN=
# OpenAI API key from platform.openai.com (ChatGPT Plus does not include API access)
OPENAI_API_KEY=
# Model for both passes (gpt-5.5 tested best)
OPENAI_MODEL=gpt-5.5
# Leave empty for gpt-5.x (they reject temperature). e.g. 0.4 for gpt-4.1
OPENAI_TEMPERATURE=
# Optional: comma-separated Telegram user IDs. Empty = anyone who finds the bot can use it
ALLOWED_USER_IDS=

# --- Google Doc mode ("go humanize") ---
# The long ID from the Doc URL: docs.google.com/document/d/<THIS>/edit
GOOGLE_DOC_ID=
# Local: path to the downloaded key file (git-ignored)
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# Railway: paste the WHOLE key JSON here instead of using a file
GOOGLE_SERVICE_ACCOUNT_JSON=
# false = dry run (result saved under STATE_DIR, the Doc is never changed). true = replace the Doc.
DOC_WRITE_ENABLED=false
# brackets = [thoughtful] - ElevenLabs audio tags (Eleven v4, v4 Turbo, v3). parentheses = (thoughtful), none = no cues
CUE_STYLE=brackets
# Tunable checks
DOC_MIN_WORDS=200
DOC_LENGTH_TOLERANCE=0.15
CUE_SIMILARITY_MIN=0.90
# Tab to read/write (the "tab=" value in the Doc URL)
GOOGLE_DOC_TAB_ID=t.0
# Hashes + last 3 backups. On Railway: mount a volume and set this to its path, e.g. /data
STATE_DIR=
# true re-enables the old paste / .txt / /go / /cancel flow
LEGACY_TXT_FLOW=false
